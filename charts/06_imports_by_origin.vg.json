{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "New Zealand Leads Cheese Imports",
    "subtitle": "Top 10 cheese import origins (tonnes), 2024-2025",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": 380,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/cheese_imports_by_origin_tonnes.csv",
    "format": {
      "type": "csv",
      "parse": {
        "2024_25": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.origin != 'Other EU' && datum.origin != 'Other'"
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "2024_25", "order": "descending"}]
    },
    {
      "filter": "datum.rank <= 10"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#a93226",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "origin",
          "type": "nominal",
          "sort": {"field": "2024_25", "order": "descending"},
          "title": null,
          "axis": {"labelFontSize": 11}
        },
        "x": {
          "field": "2024_25",
          "type": "quantitative",
          "title": "Volume (tonnes)",
          "axis": {"labelFontSize": 11}
        },
        "x2": {"datum": 0}
      }
    },
    {
      "mark": {
        "type": "circle",
        "color": "#a93226",
        "size": 100
      },
      "encoding": {
        "y": {
          "field": "origin",
          "type": "nominal",
          "sort": {"field": "2024_25", "order": "descending"}
        },
        "x": {
          "field": "2024_25",
          "type": "quantitative"
        },
        "tooltip": [
          {"field": "origin", "type": "nominal", "title": "Origin"},
          {"field": "2024_25", "type": "quantitative", "title": "Tonnes", "format": ","}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}, "font": "Inter, sans-serif"}
}

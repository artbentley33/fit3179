{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Asia Accounts for Most Australian Cheese Export Value",
    "subtitle": "Australian cheese export value by region (A$ million), 2024-25",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/cheese_exports_value_by_region.csv",
    "format": {
      "type": "csv",
      "parse": {"value_aud_million": "number"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#B65C3A",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "region",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {"labelFontSize": 11}
        },
        "x": {
          "field": "value_aud_million",
          "type": "quantitative",
          "title": "Value (A$ million)",
          "axis": {"labelFontSize": 11}
        },
        "x2": {"datum": 0}
      }
    },
    {
      "mark": {
        "type": "circle",
        "color": "#B65C3A",
        "size": 100
      },
      "encoding": {
        "y": {
          "field": "region",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "value_aud_million",
          "type": "quantitative"
        },
        "tooltip": [
          {"field": "region", "type": "nominal", "title": "Region"},
          {"field": "value_aud_million", "type": "quantitative", "title": "Value (A$m)", "format": ","}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}, "font": "Inter, sans-serif"}
}

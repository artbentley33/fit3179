{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "NSW Wins the Most Cheese Awards",
    "subtitle": "Medals awarded at Sydney Royal 2025 by state",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [134, -29],
    "scale": 500
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/STE_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#D9D9D9",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/cheese_medals_by_state.csv",
        "format": {
          "type": "csv",
          "parse": {
            "total_medals": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {"state": "NSW", "lon": 146.5, "lat": -32.5},
                {"state": "VIC", "lon": 144.5, "lat": -37},
                {"state": "TAS", "lon": 146.5, "lat": -42},
                {"state": "SA", "lon": 135, "lat": -29.5},
                {"state": "WA", "lon": 122, "lat": -26},
                {"state": "QLD", "lon": 144, "lat": -23}
              ]
            },
            "key": "state",
            "fields": ["lon", "lat"]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.7,
        "color": "#7656A6",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "total_medals",
          "type": "quantitative",
          "title": "Total Medals",
          "scale": {
            "domain": [1, 85],
            "range": [100, 3000]
          },
          "legend": {
            "title": "Total Medals",
            "orient": "right",
            "values": [1, 20, 40, 60, 80]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "total_medals",
            "type": "quantitative",
            "title": "Total Medals"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "WA", "lon": 122, "lat": -25.5},
          {"state": "NT", "lon": 133.5, "lat": -17},
          {"state": "SA", "lon": 138, "lat": -26.5},
          {"state": "QLD", "lon": 145, "lat": -22},
          {"state": "NSW", "lon": 153, "lat": -31},
          {"state": "VIC", "lon": 140, "lat": -36},
          {"state": "TAS", "lon": 148.5, "lat": -41.5}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#333",
        "dy": 25
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#fafafa"
    },
    "font": "Inter, sans-serif"
  }
}

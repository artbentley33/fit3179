{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "South Australia Leads in Milk Yield per Cow",
    "subtitle": "Estimated milk production per cow by state (litres), 2024-25",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [134, -29],
    "scale": 500
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/STE_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME16",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/milk_per_cow_by_state.csv"
            },
            "key": "state",
            "fields": ["milk_litres_per_cow"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "milk_litres_per_cow",
          "type": "quantitative",
          "title": "Litres per cow",
          "scale": {
            "scheme": "oranges",
            "domain": [0, 7400]
          },
          "legend": {
            "title": "Litres per cow",
            "orient": "right"
          }
        },
        "tooltip": [
          {"field": "properties.STE_NAME16", "type": "nominal", "title": "State"},
          {"field": "milk_litres_per_cow", "type": "quantitative", "title": "Litres per cow", "format": ","}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "WA", "lon": 122.0, "lat": -26.5},
          {"state": "NT", "lon": 133.5, "lat": -20.5},
          {"state": "SA", "lon": 135.0, "lat": -29.5},
          {"state": "QLD", "lon": 144.5, "lat": -23.5},
          {"state": "NSW", "lon": 146.5, "lat": -32.5},
          {"state": "VIC", "lon": 144.5, "lat": -37.0},
          {"state": "TAS", "lon": 146.5, "lat": -42.0}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#333"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "state", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "font": "Inter, sans-serif"}
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Cheese Leads Consumption of Solid Dairy Products",
    "subtitle": "Per capita consumption of solid dairy products (kg), 2020-21 and 2024-25",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": 1050,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/per_capita_consumption.csv"
  },
  "transform": [
    {"filter": "datum.year == '2020-21' || datum.year == '2024-25'"},
    {
      "fold": ["cheese_kg", "butter_blends_kg", "yoghurt_kg"],
      "as": ["product", "kg"]
    },
    {
      "calculate": "replace(replace(datum.product, '_kg', ''), '_blends', '')",
      "as": "product_label"
    },
    {"calculate": "upper(substring(datum.product_label, 0, 1)) + substring(datum.product_label, 1)", "as": "label"}
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {"title": null, "labelAngle": 0}
        },
        "y": {
          "field": "kg",
          "type": "quantitative",
          "axis": {"title": "Consumption (kg)"}
        },
        "color": {
          "field": "label",
          "type": "nominal",
          "scale": {
            "domain": ["Cheese", "Butter", "Yoghurt"],
            "range": ["#E0A800", "#CC79A7", "#0072B2"]
          },
          "legend": {
            "title": "Product",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "detail": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "kg",
          "type": "quantitative"
        },
        "color": {
          "field": "label",
          "type": "nominal",
          "scale": {
            "domain": ["Cheese", "Butter", "Yoghurt"],
            "range": ["#d97706", "#999999", "#009e73"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "label", "type": "nominal", "title": "Product"},
          {"field": "kg", "type": "quantitative", "title": "Consumption (kg)"}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}, "font": "Inter, sans-serif"}
}

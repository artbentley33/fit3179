{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Cottage Cheese Has the Lowest Fat and SNF Content",
    "subtitle": "Cheese Composition: Fat vs Solids Non-Fat (%)",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": 380,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/cheese_composition.csv"
  },
  "mark": {
    "type": "point",
    "filled": true,
    "size": 200,
    "stroke": "white",
    "strokeWidth": 1.5
  },
  "encoding": {
    "x": {
      "field": "fat_pct",
      "type": "quantitative",
      "title": "Fat (%)",
      "scale": {
        "domain": [0, 40]
      },
      "axis": {
        "labelFontSize": 11
      }
    },
    "y": {
      "field": "snf_pct",
      "type": "quantitative",
      "title": "Solids Non-Fat (%)",
      "scale": {
        "domain": [0, 50]
      },
      "axis": {
        "labelFontSize": 11
      }
    },
    "color": {
      "field": "cheese",
      "type": "nominal",
      "scale": {
        "domain": [
          "Cheddar cheese",
          "Edam",
          "Gouda",
          "Parmesan",
          "Mozzarella",
          "Brie",
          "Cottage cheese"
        ],
        "range": [
          "#E76F8A",
          "#17A2A4",
          "#6B6ECF",
          "#B8A1D9",
          "#64748B",
          "#C4A000",
          "#8C6D5A"
        ]
      },
      "legend": {
        "title": "Cheese Type",
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 3,
        "labelFontSize": 10,
        "symbolSize": 80,
        "offset": 10
      }
    },
    "tooltip": [
      {
        "field": "cheese",
        "type": "nominal",
        "title": "Cheese"
      },
      {
        "field": "fat_pct",
        "type": "quantitative",
        "title": "Fat (%)",
        "format": ".1f"
      },
      {
        "field": "snf_pct",
        "type": "quantitative",
        "title": "SNF (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, sans-serif"
  }
}

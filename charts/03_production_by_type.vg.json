{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Cheddar Dominates Australian Cheese Production",
    "subtitle": "Annual cheese production by type (tonnes), 2019-20 to 2024-25",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": 280,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/cheese_production_by_type.csv"
  },
  "transform": [
    {
      "fold": ["Cheddar", "Semi_Hard", "Hard_Grating", "Fresh", "Mould"],
      "as": ["type", "tonnes"]
    },
    {"calculate": "replace(datum.type, '_', ' ')", "as": "type_label"}
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {"labelAngle": -30, "labelFontSize": 10}
    },
    "y": {
      "field": "type_label",
      "type": "nominal",
      "title": null,
      "axis": {"labelFontSize": 11}
    },
    "color": {
      "field": "tonnes",
      "type": "quantitative",
      "title": "Tonnes",
      "scale": {
        "scheme": "greens",
        "domain": [0, 210000]
      },
      "legend": {"title": "Tonnes", "orient": "right"}
    },
    "tooltip": [
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "type_label", "type": "nominal", "title": "Type"},
      {"field": "tonnes", "type": "quantitative", "title": "Tonnes", "format": ","}
    ]
  },
  "config": {"view": {"stroke": null}, "font": "Inter, sans-serif"}
} 

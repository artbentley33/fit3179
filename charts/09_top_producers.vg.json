{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Real Dairy Australia Earns the Most Medals",
    "subtitle": "Top 10 cheese producers by medals at Sydney Royal 2025",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": 320,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/cheese_medals_by_producer.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.gold) + toNumber(datum.silver) + toNumber(datum.bronze)",
      "as": "total_medals"
    },
    {
      "window": [
        {"op": "rank", "as": "rank"}
      ],
      "sort": [
        {"field": "total_medals", "order": "descending"}
      ]
    },
    {
      "filter": "datum.rank <= 10"
    },
    {
      "fold": ["gold", "silver", "bronze"],
      "as": ["medal", "count"]
    },
    {
      "calculate": "upper(datum.medal)",
      "as": "medal_label"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "exhibitor",
      "type": "nominal",
      "sort": {
        "field": "total_medals",
        "op": "max",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelFontSize": 11,
        "labelLimit": 200
      }
    },
    "x": {
      "aggregate": "sum",
      "field": "count",
      "type": "quantitative",
      "title": "Medals",
      "axis": {
        "labelFontSize": 11
      }
    },
    "color": {
      "field": "medal_label",
      "type": "nominal",
      "scale": {
        "domain": ["GOLD", "SILVER", "BRONZE"],
        "range": ["#E3B341", "#a8a8a8", "#B8734E"]
      },
      "legend": {
        "title": "Medal Type",
        "orient": "bottom",
        "direction": "horizontal",
        "labelFontSize": 11,
        "symbolSize": 100
      }
    },
    "order": {
      "field": "medal_label",
      "sort": "ascending"
    },
    "tooltip": [
      {
        "field": "exhibitor",
        "type": "nominal",
        "title": "Producer"
      },
      {
        "field": "state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "medal_label",
        "type": "nominal",
        "title": "Medal"
      },
      {
        "aggregate": "sum",
        "field": "count",
        "type": "quantitative",
        "title": "Count"
      }
    ]
  },
  "config": {
    "view": {"stroke": null},
    "font": "Inter, sans-serif"
  }
}

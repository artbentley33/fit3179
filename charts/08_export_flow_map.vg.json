        "url": "https://raw.githubusercontent.com/artbentley33/fit3179/main/data/cheese_exports_by_destination_tonnes.csv",
        "format": {
          "type": "csv",
          "parse": {"2024_25": "number"}
        }
      },
      "transform": [
        {
          "window": [{"op": "rank", "as": "rank"}],
          "sort": [{"field": "2024_25", "order": "descending"}]
        },
        {"filter": "datum.rank <= 10"},
        {
          "lookup": "destination",

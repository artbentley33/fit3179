        {"calculate": "-33.5", "as": "origin_lat"}
      ],
      "mark": {"type": "rule", "color": "#0D7377", "opacity": 0.7},
      "encoding": {
        "longitude": {"field": "origin_lon", "type": "quantitative"},
        "latitude": {"field": "origin_lat", "type": "quantitative"},
        "longitude2": {"field": "lon", "type": "quantitative"},
        "latitude2": {"field": "lat", "type": "quantitative"},

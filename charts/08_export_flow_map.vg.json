    "text": "Japan Is Australia's Largest Cheese Export Destination",
    "subtitle": "Top 10 destinations by Australian cheese export volume (tonnes), 2024-25",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10

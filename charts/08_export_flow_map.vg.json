          "scale": {"domain": [1000, 70000], "range": [1, 10]},
          "legend": {
            "title": "Export Volume (tonnes)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 300
          }
        },
        "tooltip": [
          {"field": "destination", "type": "nominal", "title": "Destination"},
          {"field": "2024_25", "type": "quantitative", "title": "Tonnes", "format": ","}
        ]
      }
    },
    {
